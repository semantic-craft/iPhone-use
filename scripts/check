#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT_DIR"

echo "==> [1/4] swift test"
swift test

echo "==> [2/4] swift build -c release"
swift build -c release

echo "==> [3/4] python unit tests"
python3 -B -m unittest discover -s Tests/PythonTests -p 'test_*.py'

echo "==> [4/4] MCP stdio contract check"
python3 -B scripts/check-mcp.py

if [[ -f "$ROOT_DIR/docs/pstack-relay.md" && -x "$ROOT_DIR/scripts/pstack-relay" ]]; then
  echo "==> [relay] pstack-relay selftest"
  python3 "$ROOT_DIR/scripts/pstack-relay" selftest
fi

echo "check: PASS"
